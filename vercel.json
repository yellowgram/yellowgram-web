{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^yellowgram\\.vercel\\.app$" }],
      "destination": "https://www.yellowgram.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^yellowgram-.+\\.vercel\\.app$" }],
      "destination": "https://www.yellowgram.dev/:path*",
      "permanent": true
    }
  ]
}
